{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "6aa5348c7b75f85db0962e1c94f587b8",
  "name": "seo-researcher",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://seoresearcher.ai",
    "API_ORIGIN": "https://api.seoresearcher.ai",
    "MCP_ORIGIN": "https://mcp.seoresearcher.ai",
    "RANKABILITY_APP_ORIGIN": "https://app.rankability.com",
    "RANKABILITY_AGENT_API_ORIGIN": "https://app.rankability.com/api/agent/v1",
    "SIGNUP_URL": "https://app.seoresearcher.ai/start?interval=monthly",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "analytics_engine_datasets": [
    {
      "binding": "SEO_ANALYTICS",
      "dataset": "seo_researcher_events"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
