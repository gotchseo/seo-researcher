{
  "name": "seo-researcher",
  "version": "0.1.0",
  "private": true,
  "mcpName": "io.github.gotchseo/seo-researcher",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev",
    "build": "node scripts/package-skills.mjs && astro build && node scripts/embed-site.mjs",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "validate": "npm run build && npm run check && npm test && npm run deploy:dry",
    "package:skills": "node scripts/package-skills.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@tailwindcss/vite": "4.2.1",
    "agents": "0.22.0",
    "astro": "7.2.10",
    "tailwindcss": "4.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/sitemap": "3.7.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
