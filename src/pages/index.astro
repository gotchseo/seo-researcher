---
import "../styles/global.css";

const title = "SEO Researcher — SEO research for Claude, Codex, Cursor, and AI agents";
const description = "Research live Google competitors, topics, entities, search questions, content gaps, and AI citations before your AI agent writes.";
const canonical = "https://seoresearcher.ai/";

const features = [
  { n: "01", title: "Google competitors", body: "See which pages actually rank for the target search and what is on each page." },
  { n: "02", title: "Topics", body: "Understand what top-ranking content consistently covers and how it structures the subject." },
  { n: "03", title: "Entities", body: "Find the people, brands, products, concepts, and terms that matter to the topic." },
  { n: "04", title: "AI citations", body: "See the URLs cited across AI search results, including which AI platform cited each source." },
  { n: "05", title: "Content gaps", body: "Find useful questions, evidence, and subtopics that competing pages have missed." },
  { n: "06", title: "Search questions", body: "Discover the questions people ask and carry the relevant ones into the content plan." },
];

const faq = [
  { q: "Is SEO Researcher another AI writer?", a: "No. It does not write articles. It analyzes the pages that rank, what they cover, which entities matter, what AI systems cite, and where the gaps are, then hands that research to the agent you already write with." },
  { q: "What does the research include?", a: "Google competitors, topics, entities, AI citations with the platform that cited each source, content gaps, search questions, and source URLs." },
  { q: "Which tools does it work with?", a: "Claude, Codex, Cursor, OpenClaw, and any MCP client. A REST API is also included." },
  { q: "How does the trial work?", a: "Create your account, add a card, and connect your agent. The trial runs 14 days. Cancel before it ends and you will not be charged; otherwise it is $49/month." },
  { q: "Do I need to count credits?", a: "No. There is no credit counter for normal use. Run research whenever it should happen before writing." },
];

const testimonials = [
  { quote: "Creating content briefs used to take hours, but now the process is fast and precise. It also helps me match keyword intent accurately by analyzing data from 30 competitors for the primary keyword, all in one place.", name: "Tharun B.", role: "SEO Strategist", source: "G2" },
  { quote: "It gives me an exact roadmap of what I should cover in every piece of content—a very objective way of measuring how well-optimized a piece of content is. It makes it very easy to evaluate writers’ content and make sure they are hitting their targets.", name: "Jacob P.", role: "Marketing Consultant", source: "G2" },
  { quote: "It identifies content gaps, excludes outliers, and helps craft comprehensive and engaging content that actually ranks. It’s been instrumental in ranking our clients’ website pages organically.", name: "Jared T.", role: "Agency Owner", source: "G2" },
  { quote: "None of the other software that offer NLP gave me results like this. Using the suggestions I created 17 new pages on a brand new domain. In June 2025 alone it generated 25 leads each valued at £500. Not bad for a brand new domain with no links.", name: "Raitis K.", role: "Local SEO for Construction Companies", source: "G2" },
  { quote: "The core function that other SEO software systems are not addressing is a score based on relevance. Relevance is more important than search volume, keyword difficulty, or anything else.", name: "Chad E.", role: "President", source: "G2" },
  { quote: "The tool gathers all competition for specific needs and aids us in making quality content in a much quicker time, as well as being able to serve our clients better.", name: "Lucas H.", role: "Director of Marketing & Design", source: "G2" },
  { quote: "Having everything I need for SEO writing—content outlines, competitor’s websites, and keywords—all in one place has made my workflow incredibly efficient.", name: "Sam Barclay", role: "Top-Rated SEO Copywriter on Fiverr", source: "Review" },
  { quote: "It helps with SEO writing and knowing what Google expects to see for content on a page.", name: "Seth L.", role: "Small-Business Owner", source: "G2" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "SEO Researcher",
    url: canonical,
    description,
    publisher: { "@type": "Organization", name: "Rankability", url: "https://www.rankability.com/" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "SEO Researcher",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    brand: { "@type": "Brand", name: "Rankability" },
    offers: {
      "@type": "Offer",
      price: "49",
      priceCurrency: "USD",
      description: "14-day card-required trial, then $49 per month",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://seoresearcher.ai/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://seoresearcher.ai/og.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-shell">
      <a class="brand-lockup" href="/" aria-label="SEO Researcher home"><span>SEO Researcher</span><small>By Rankability</small></a>
      <a class="text-link" href="#pricing" data-event="trial_cta_clicked" data-location="header">Start trial</a>
    </header>

    <main id="main">
      <section class="hero page-shell" aria-labelledby="hero-title">
        <p class="eyebrow">For marketers creating SEO content with AI</p>
        <h1 id="hero-title">Give your AI agent the SEO research it’s missing.</h1>
        <p class="hero-lead">See what ranking pages cover, what they miss, and which sources AI systems cite—then give the findings directly to Claude or your agent.</p>
        <div class="cta-stack">
          <a class="primary-button" href="#pricing" data-event="trial_cta_clicked" data-location="hero">Start your 14-day trial <span aria-hidden="true">→</span></a>
          <p class="small-copy">Next: create your account, add a card, and connect your agent. $49/month after 14 days. Cancel anytime.</p>
        </div>
        <p class="works-with">Works with Claude · Codex · Cursor · OpenClaw · Any MCP client</p>
      </section>

      <section class="section page-shell" aria-labelledby="missing-layer-title">
        <div class="section-heading">
          <p class="eyebrow">The missing layer</p>
          <h2 id="missing-layer-title">Claude can write. It is not an SEO research system.</h2>
          <p class="section-lead">Web search can find pages. SEO Researcher analyzes the pages that actually rank, what they consistently cover, which entities matter, what AI systems cite, and where the useful gaps are.</p>
        </div>
      </section>

      <section id="research" class="section page-shell" aria-labelledby="research-title">
        <div class="section-heading feature-heading">
          <p class="eyebrow">Research before you write</p>
          <h2 id="research-title">One request returns competitors, topics, gaps, and citations.</h2>
          <p class="section-lead">Give your agent evidence it can use—not another generic article draft.</p>
        </div>
        <div class="feature-list">
          {features.map((feature) => <article class="feature-row"><span class="index">{feature.n}</span><h3>{feature.title}</h3><p>{feature.body}</p></article>)}
        </div>
      </section>

      <section id="how" class="section page-shell" aria-labelledby="how-title">
        <div class="section-heading feature-heading">
          <p class="eyebrow">No new content workflow</p>
          <h2 id="how-title">Connect once. Keep working where you already work.</h2>
        </div>
        <ol class="steps">
          <li><span class="index">1</span><div><h3>Connect your agent</h3><p>Authorize SEO Researcher in Claude, Codex, Cursor, OpenClaw, or another MCP tool.</p></div></li>
          <li><span class="index">2</span><div><h3>Ask for research</h3><p>“Research ‘best CRM software’ before we create this article.”</p></div></li>
          <li><span class="index">3</span><div><h3>Write with evidence</h3><p>Your agent receives competitors, topics, entities, questions, citations, gaps, and source URLs.</p></div></li>
        </ol>
      </section>

      <section class="section page-shell" aria-labelledby="agents-title">
        <div class="section-heading">
          <p class="eyebrow">Built for agents</p>
          <h2 id="agents-title">Ask your agent to research any SEO topic.</h2>
          <p class="section-lead">Your agent receives organized findings and source URLs it can use in its next step.</p>
        </div>
        <div class="prompt-box">
          <div class="prompt-meta"><span>You</span><button type="button" class="copy-button" data-copy-prompt="Research the topic “best CRM software” before we create this article." data-event="example_prompt_copied">Copy prompt</button></div>
          <p>Research the topic “best CRM software” before we create this article.</p>
        </div>
      </section>

      <section id="results" class="section page-shell" aria-labelledby="results-title">
        <div class="section-heading">
          <p class="eyebrow">Results</p>
          <h2 id="results-title">What marketers say about research-led content.</h2>
          <p class="reviews-meta">5.0 from 136 reviews · Verified on Google, G2 &amp; Capterra</p>
        </div>
        <div class="testimonial-list">
          {testimonials.map((testimonial) => <figure><blockquote>“{testimonial.quote}”</blockquote><figcaption><strong>{testimonial.name}</strong> · {testimonial.role} · {testimonial.source}</figcaption></figure>)}
        </div>
      </section>

      <section id="pricing" class="section page-shell" aria-labelledby="pricing-title">
        <div class="section-heading">
          <p class="eyebrow">Simple pricing</p>
          <h2 id="pricing-title">Research every article without counting credits.</h2>
          <p class="section-lead">There is no credit counter to manage. Connect SEO Researcher to your agent and use it whenever research should happen before writing.</p>
        </div>
        <div class="plan">
          <div class="plan-title-row"><h3>SEO Researcher</h3><div class="price"><strong>$49</strong><span>/month</span></div></div>
          <div class="plan-meta"><span>or $490/year—two months free</span><span>14-day free trial</span><span>Card required to start</span></div>
          <ul>
            <li><span aria-hidden="true">—</span>Google competitor and AI citation research</li>
            <li><span aria-hidden="true">—</span>MCP and REST API access</li>
            <li><span aria-hidden="true">—</span>No credit counter for normal use</li>
          </ul>
          <div class="cta-stack">
            <a class="primary-button" href="/start" data-event="trial_cta_clicked" data-location="pricing">Start your 14-day trial <span aria-hidden="true">→</span></a>
            <p class="small-copy">Cancel before the trial ends and you will not be charged.</p>
          </div>
        </div>
      </section>

      <section id="faq" class="section page-shell" aria-labelledby="faq-title">
        <div class="section-heading"><p class="eyebrow">Questions</p><h2 id="faq-title">What you need to know.</h2></div>
        <div class="faq-list">
          {faq.map(({ q, a }) => <details><summary data-event="faq_toggled"><span>{q}</span><span class="faq-icon" aria-hidden="true"></span></summary><p>{a}</p></details>)}
        </div>
      </section>

      <section class="section final-cta page-shell" aria-labelledby="final-title">
        <div class="section-heading">
          <p class="eyebrow">Your AI can write</p>
          <h2 id="final-title">Give it better research.</h2>
          <p class="section-lead">Connect your agent to live Google competitors, topics, entities, content gaps, search questions, and AI citations.</p>
          <a class="primary-button final-button" href="#pricing" data-event="trial_cta_clicked" data-location="final">Start your 14-day trial <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer page-shell">
      <span>SEO Researcher · By Rankability</span>
      <nav aria-label="Footer navigation"><a href="https://docs.seoresearcher.ai">Documentation</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
    </footer>
    <script is:inline src="/analytics.js" defer></script>
  </body>
</html>

<style>
  .page-shell { width: 100%; max-width: 720px; margin-inline: auto; padding-inline: 24px; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 28px; }
  .brand-lockup { display: flex; align-items: baseline; gap: 10px; min-width: 0; color: var(--navy); text-decoration: none; white-space: nowrap; }
  .brand-lockup > span { font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
  .brand-lockup small { color: var(--navy-50); font-size: 12px; font-weight: 400; }
  .text-link, .copy-button { color: var(--navy); border: 0; border-bottom: 1px solid var(--navy-30); background: none; padding: 0 0 1px; text-decoration: none; transition: border-color 150ms ease-out, color 150ms ease-out; }
  .text-link { flex-shrink: 0; font-size: 14px; white-space: nowrap; }
  .text-link:hover, .copy-button:hover { color: var(--navy); border-color: var(--navy); text-decoration: none; }
  .hero { display: flex; flex-direction: column; gap: 28px; padding-block: 96px; }
  .eyebrow { margin: 0; color: var(--navy-55); font-size: 12px; font-weight: 500; letter-spacing: .08em; line-height: normal; text-transform: uppercase; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { margin: 0; color: var(--navy); font-size: 52px; font-weight: 600; letter-spacing: -.03em; line-height: 1.05; }
  h2 { margin: 0; color: var(--navy); font-size: 34px; font-weight: 600; letter-spacing: -.025em; line-height: 1.15; }
  .hero-lead { margin: 0; color: var(--navy-75); font-size: 20px; line-height: 1.5; }
  .section { border-top: 1px solid var(--navy-10); padding-top: 64px; padding-bottom: 96px; }
  .section-heading { display: flex; flex-direction: column; gap: 20px; }
  .section-lead { margin: 0; color: var(--navy-75); font-size: 18px; line-height: 1.55; }
  .primary-button { display: inline-flex; align-items: center; gap: 12px; width: fit-content; min-height: 48px; border-radius: 6px; background: var(--navy); color: #fff; padding: 12px 24px; font-size: 16px; font-weight: 600; line-height: 1.5; text-decoration: none; white-space: nowrap; transition: background-color 150ms ease-out; }
  .primary-button span { color: var(--lime); }
  .primary-button:hover { background: var(--blue); color: #fff; text-decoration: none; }
  .cta-stack { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
  .small-copy, .works-with { margin: 0; color: var(--navy-55); font-size: 13px; line-height: 1.5; }
  .works-with { margin-top: 12px; }
  .feature-heading { margin-bottom: 48px; }
  .feature-list { display: flex; flex-direction: column; }
  .feature-row { display: grid; grid-template-columns: 40px 200px 1fr; align-items: baseline; gap: 16px; border-top: 1px solid var(--navy-10); padding-block: 20px; }
  .index { color: var(--navy-40); font-size: 13px; font-weight: 500; }
  .feature-row h3 { margin: 0; color: var(--navy); font-size: 17px; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; }
  .feature-row p { margin: 0; color: var(--navy-70); font-size: 15px; line-height: 1.55; }
  .steps { display: flex; flex-direction: column; gap: 32px; margin: 0; padding: 0; list-style: none; }
  .steps li { display: grid; grid-template-columns: 40px 1fr; gap: 16px; }
  .steps .index { padding-top: 4px; }
  .steps li > div { display: flex; flex-direction: column; gap: 6px; }
  .steps h3 { margin: 0; color: var(--navy); font-size: 19px; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; }
  .steps p { margin: 0; color: var(--navy-70); font-size: 16px; line-height: 1.55; }
  .prompt-box { display: flex; flex-direction: column; gap: 12px; margin-top: 32px; border: 1px solid var(--navy-14); border-radius: 8px; padding: 20px 24px; }
  .prompt-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .prompt-meta > span { color: var(--navy-50); font-size: 12px; }
  .copy-button { cursor: pointer; font-size: 13px; white-space: nowrap; }
  .prompt-box > p { margin: 0; color: var(--navy); font-size: 17px; line-height: 1.5; }
  .reviews-meta { margin: 0; color: var(--navy-55); font-size: 14px; line-height: 1.5; }
  .testimonial-list { display: flex; flex-direction: column; margin-top: 40px; border-top: 1px solid var(--navy-10); }
  .testimonial-list figure { display: flex; flex-direction: column; gap: 12px; margin: 0; border-bottom: 1px solid var(--navy-10); padding-block: 24px; }
  .testimonial-list blockquote { margin: 0; color: var(--navy); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .testimonial-list figcaption { color: var(--navy-55); font-size: 13px; line-height: 1.5; }
  .testimonial-list figcaption strong { color: var(--navy); font-weight: 400; }
  .plan { display: flex; flex-direction: column; gap: 24px; margin-top: 40px; border-top: 1px solid var(--navy); padding-top: 28px; }
  .plan-title-row { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 24px; }
  .plan-title-row h3 { margin: 0; color: var(--navy); font-size: 18px; font-weight: 600; }
  .price { display: flex; align-items: baseline; gap: 6px; }
  .price strong { color: var(--navy); font-size: 48px; font-weight: 600; letter-spacing: -.03em; line-height: 1; }
  .price span { color: var(--navy-55); font-size: 15px; }
  .plan-meta { display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--navy-60); font-size: 14px; line-height: 1.5; }
  .plan ul { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; color: var(--navy); font-size: 16px; list-style: none; }
  .plan li { display: flex; gap: 12px; }
  .plan li span { flex: 0 0 auto; color: var(--blue); }
  .faq-list { display: flex; flex-direction: column; margin-top: 40px; border-top: 1px solid var(--navy-10); }
  .faq-list details { border-bottom: 1px solid var(--navy-10); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 18px; color: var(--navy); cursor: pointer; font-size: 17px; font-weight: 500; letter-spacing: -.01em; line-height: 1.4; list-style: none; transition: color 150ms ease-out; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:hover { color: var(--blue); }
  .faq-icon { flex: 0 0 auto; color: var(--navy-50); font-size: 16px; }
  .faq-icon::before { content: "+"; }
  details[open] .faq-icon::before { content: "−"; }
  .faq-list details > p { margin: 0; color: var(--navy-70); padding: 0 48px 20px 0; font-size: 16px; line-height: 1.6; }
  .final-cta { padding-bottom: 120px; }
  .final-cta h2 { font-size: 40px; letter-spacing: -.03em; line-height: 1.1; }
  .final-button { margin-top: 8px; }
  .site-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; border-top: 1px solid var(--navy-10); padding-block: 24px; color: var(--navy-55); font-size: 13px; line-height: 1.5; }
  .site-footer > span { white-space: nowrap; }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .site-footer a { color: var(--navy-55); text-decoration: none; }
  .site-footer a:hover { color: var(--navy); text-decoration: underline; }

  @media (max-width: 600px) {
    .hero { padding-block: 72px 80px; }
    h1 { font-size: 40px; }
    h2 { font-size: 28px; }
    .feature-row { grid-template-columns: 40px 1fr; }
    .feature-row p { grid-column: 2; }
    .price strong { font-size: 40px; }
    .final-cta h2 { font-size: 34px; }
  }

  @media (max-width: 380px) {
    .page-shell { padding-inline: 18px; }
    .site-header { gap: 16px; }
    .brand-lockup { display: block; white-space: normal; }
    .brand-lockup small { display: block; margin-top: 2px; }
    .primary-button { width: 100%; white-space: normal; }
  }
</style>
